FOODHUB_APP_NAME=FoodHub API
FOODHUB_APP_ENV=local
FOODHUB_DEBUG=true
FOODHUB_API_PREFIX=/api
FOODHUB_DATABASE_URL=mysql+asyncmy://foodhub:foodhub_local_password@localhost:3306/foodhub?charset=utf8mb4
FOODHUB_DATABASE_ECHO=false
FOODHUB_AUTH_SESSION_HOURS=168
FOODHUB_THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1
FOODHUB_THEMEALDB_API_KEY=1
FOODHUB_THEMEALDB_TIMEOUT_SECONDS=6
FOODHUB_THEMEALDB_MAX_CONCURRENCY=5
FOODHUB_DISH_MATCH_THRESHOLD=0.85
FOODHUB_OPENAI_API_KEY=
FOODHUB_OPENAI_MODEL=
FOODHUB_OPENAI_TIMEOUT_SECONDS=90
FOODHUB_DEMO_AVAILABLE=true
FOODHUB_LIVE_SCAN_ENABLED=false
FOODHUB_MENU_IMAGE_MAX_BYTES=10485760
FOODHUB_MENU_IMAGE_MAX_COUNT=5
FOODHUB_MENU_IMAGES_TOTAL_MAX_BYTES=31457280
FOODHUB_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
